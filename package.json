{
  "name": "adblock-mv3",
  "version": "1.0.0",
  "description": "Production-ready, privacy-first Chrome AdBlock & Tracker Blocking Extension built on Manifest V3 and DeclarativeNetRequest.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.js",
    "validate-rules": "node scripts/validate-rules.js",
    "test": "node --test dist-test/**/*.test.js",
    "test:src": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "audit": "node scripts/audit.js",
    "verify": "npm run typecheck && npm run validate-rules && npm run test:src && npm run build && npm run audit"
  },
  "keywords": [
    "adblock",
    "tracker-blocker",
    "chrome-extension",
    "manifest-v3",
    "declarativeNetRequest",
    "privacy"
  ],
  "author": "Senior Chrome Extension Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
